{
	"compilerOptions": {
		// Entorno y módulos modernos compatibles con el runtime de Bun
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",

		// Verificación estricta de tipos y optimización de compilación
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],

		// Soporte JSX nativo de alto rendimiento mediante el motor de Hono
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	}
}
